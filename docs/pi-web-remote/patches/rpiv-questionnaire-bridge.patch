+			[{ questionIndex: 0, text: " " }],
+			[{ questionIndex: 0, optionIndexes: [] }],
+		]) {
+			expect(h.submit(q, JSON.stringify(answers), answers).verdict).toBe("invalid");
+		}
+		expect(h.submit({ ...q, revision: "old" }).verdict).toBe("stale");
+		expect(h.submit({ ...q, toolCallId: "missing" }).verdict).toBe("stale");
+		expect(h.ui.select).toHaveBeenCalledTimes(1);
+		h.submit(q, "valid");
+		await done;
+	});
+
+	it("工具 AbortSignal 产生 aborted 而非 accepted/decline，关闭 UI", async () => {
+		const h = harness();
+		const controller = new AbortController();
+		const done = h.run("call", undefined, controller.signal);
+		const rejected = expect(done).rejects.toMatchObject({ name: "AbortError" });
+		const q = h.ref();
+		controller.abort();
+		await rejected;
+		expect(h.states.at(-1)).toMatchObject({ state: "aborted" });
+		expect(h.dialogs[0].signal?.aborted).toBe(true);
+		expect(h.submit(q).verdict).toBe("already-closed");
+	});
+
+	it("回执过期后 unknown；重开同 toolCallId 使用不同 revision", async () => {
+		const h = harness();
+		const done = h.run();
+		const q = h.ref();
+		h.submit(q);
+		await done;
+		const now = Date.now();
+		vi.spyOn(Date, "now").mockReturnValue(now + 600_001);
+		expect(h.request({ type: "operation.get", ...q, operationId: "op" }).operation!.verdict).toBe("unknown");
+		expect(h.submit(q).verdict).toBe("stale");
+		const again = h.run();
+		const newer = h.ref();
+		expect(newer.revision).not.toBe(q.revision);
+		expect(h.submit(q).verdict).toBe("stale");
+		h.submit(newer);
