@@ -0,0 +1,217 @@
+import { createEventBus } from "@earendil-works/pi-coding-agent";
+import { createMockCtx, createMockPi } from "@juicesharp/rpiv-test-utils";
+import { describe, expect, it, vi } from "vitest";
+import { registerAskUserQuestionTool } from "./ask-user-question.ts";
+import type { AskUserAnswerEntry, QuestionnaireBridgeResponse, QuestionnaireSnapshot } from "./events.ts";
+
+const REQUEST = "rpiv:ask-user:bridge-request.v1";
+const RESPONSE = "rpiv:ask-user:bridge-response.v1";
+const STATE = "rpiv:ask-user:bridge-state.v1";
+const question = (header: string, multiSelect = false) => ({
+	question: `${header}?`,
+	header,
+	multiSelect,
+	options: [
+		{ label: "A", description: "a", preview: "**A**" },
+		{ label: "B", description: "b" },
+	],
+});
+
+function harness() {
+	const bus = createEventBus();
+	const { pi, captured } = createMockPi({ events: bus } as never);
+	registerAskUserQuestionTool(pi);
+	const dialogs: Array<{ options?: string[]; answer: (value: string | undefined) => void; signal?: AbortSignal }> = [];
+	const states: QuestionnaireSnapshot[] = [];
+	bus.on(STATE, (state) => states.push(state as QuestionnaireSnapshot));
+	const show = (options?: string[], signal?: AbortSignal) =>
+		new Promise<string | undefined>((resolve) => {
+			dialogs.push({ options, answer: resolve, signal });
+			if (signal?.aborted) resolve(undefined);
+			else signal?.addEventListener("abort", () => resolve(undefined), { once: true });
+		});
+	const ui = {
+		select: vi.fn((_title: string, options: string[], opts?: { signal?: AbortSignal }) =>
+			show(options, opts?.signal),
+		),
+		input: vi.fn((_title: string, _placeholder?: string, opts?: { signal?: AbortSignal }) =>
+			show(undefined, opts?.signal),
+		),
+	};
+	const ctx = createMockCtx({ hasUI: true, mode: "rpc", ui: ui as never });
+	const run = (id = "call", questions = [question("One")], signal?: AbortSignal) =>
+		captured.tools.get("ask_user_question")!.execute(id, { questions }, signal!, undefined, ctx as never);
+	let seq = 0;
+	const request = (payload: Record<string, unknown>) => {
+		const requestId = `request-${++seq}`;
+		let result: QuestionnaireBridgeResponse | undefined;
+		const off = bus.on(RESPONSE, (data) => {
+			const response = data as QuestionnaireBridgeResponse;
+			if (response.requestId === requestId) result = response;
+		});
+		bus.emit(REQUEST, { ...payload, requestId });
+		off();
+		expect(result).toBeDefined();
+		return result!;
+	};
+	const ref = (id = "call") => request({ type: "snapshot" }).questionnaires!.find((q) => q.toolCallId === id)!;
+	const submit = (
+		q: QuestionnaireSnapshot,
+		operationId = "op",
+		answers: readonly AskUserAnswerEntry[] = [{ questionIndex: 0, optionIndexes: [1] }],
+	) => request({ type: "submit", toolCallId: q.toolCallId, revision: q.revision, operationId, answers }).operation!;
+	return { bus, run, request, ref, submit, dialogs, states, ui };
+}
+
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+describe("版本化 RPC 完整问卷桥接", () => {
