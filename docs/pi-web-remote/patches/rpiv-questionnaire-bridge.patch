+		expect((await cancelled).details).toMatchObject({ cancelled: true });
+	});
+
+	it("同 tick 最后一题与外部整份提交竞争，以控制器的第一次决胜为准", async () => {
+		const h = harness();
+		const done = h.run();
+		const q = h.ref();
