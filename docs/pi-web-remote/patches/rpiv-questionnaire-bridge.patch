+
+	it("容量驱逐不重开问卷：操作 256、关闭记录 128 的边界", async () => {
+		const h = harness();
+		const done = h.run();
+		const q = h.ref();
+		for (let i = 0; i < 257; i++) h.submit(q, `bad-${i}`, []);
+		expect(h.request({ type: "operation.get", ...q, operationId: "bad-0" }).operation!.verdict).toBe("unknown");
+		h.submit(q);
+		await done;
+		for (let i = 0; i < 129; i++) {
+			const next = h.run(`next-${i}`);
+			h.submit(h.ref(`next-${i}`));
+			await next;
