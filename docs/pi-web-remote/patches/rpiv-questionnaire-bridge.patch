+/** 网页与外部整份答案只通过原 first-wins；独立 signal 不触碰其他调用。 */
+export async function runCooperativeRpcQuestionnaire(
+	ui: DialogUI,
+	params: QuestionParams,
+	open: OpenQuestionnaire,
+): Promise<QuestionnaireResult> {
+	const signal = open.controller.signal;
+	const scoped: DialogUI = {
+		select: async (title, options) => {
+			if (signal.aborted) return undefined;
+			const value = await ui.select(title, options, { signal });
+			return signal.aborted ? undefined : value;
+		},
+		input: async (title, placeholder) => {
+			if (signal.aborted) return undefined;
+			const value = await ui.input(title, placeholder, { signal });
+			return signal.aborted ? undefined : value;
+		},
+	};
+	if (open.settled) return open.settled;
+	const walking = runRpcQuestionnaire(scoped, params).then((result) => {
+		open.settle(result);
+		return open.settled!;
+	});
+	return await Promise.race([walking, open.answeredEarly]);
+}
