diff --git a/packages/rpiv-ask-user-question/questionnaire-bridge.ts b/packages/rpiv-ask-user-question/questionnaire-bridge.ts
new file mode 100644
index 0000000..9e92cfa
--- /dev/null
+++ b/packages/rpiv-ask-user-question/questionnaire-bridge.ts
@@ -0,0 +1,129 @@
+import { createHash } from "node:crypto";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import type { OpenQuestionnaire } from "./answer-channel.ts";
+import {
+	ASK_USER_BRIDGE_REQUEST_EVENT,
+	ASK_USER_BRIDGE_RESPONSE_EVENT,
+	ASK_USER_BRIDGE_STATE_EVENT,
+	type QuestionnaireBridgeResponse,
+	type QuestionnaireOperation,
+	type QuestionnaireSnapshot,
+} from "./events.ts";
+import { resolveExternalAnswer } from "./tool/external-answer.ts";
+
+const RETAIN_MS = 600_000;
+const MAX_OPERATIONS = 256;
+const MAX_CLOSED = 128;
+const record = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+const identifier = (v: unknown): v is string => typeof v === "string" && v.length > 0 && v.length <= 128;
+
+function canonical(value: unknown): string {
+	if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+	if (record(value))
+		return `{${Object.keys(value)
+			.sort()
+			.map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`)
+			.join(",")}}`;
+	return JSON.stringify(value) ?? "null";
+}
+
+function snapshot(q: OpenQuestionnaire): QuestionnaireSnapshot {
+	return {
+		toolCallId: q.toolCallId,
+		revision: q.revision,
+		state: q.state,
+		...(q.state === "open"
+			? {
+					questions: q.questions.map((question, questionIndex) => ({
+						questionIndex,
+						question: question.question,
+						header: question.header,
+						multiSelect: question.multiSelect ?? false,
+						options: question.options.map((option, optionIndex) => ({ ...option, optionIndex })),
+					})),
+				}
+			: {}),
+	};
+}
+
+/** 有界、仅内存的原控制器回执。不保留答案正文，不承诺跨 reload／进程恢复。 */
+export function registerQuestionnaireBridge(pi: ExtensionAPI, open: ReadonlyMap<string, OpenQuestionnaire>) {
+	const operations = new Map<string, { at: number; fingerprint: string; operation: QuestionnaireOperation }>();
+	const closed = new Map<string, { at: number; value: QuestionnaireSnapshot }>();
+	const prune = () => {
+		const now = Date.now();
+		for (const [key, value] of operations) if (now - value.at >= RETAIN_MS) operations.delete(key);
+		for (const [key, value] of closed) if (now - value.at >= RETAIN_MS) closed.delete(key);
+	};
+	const trim = <T>(map: Map<string, T>, limit: number) => {
+		while (map.size > limit) map.delete(map.keys().next().value!);
+	};
+
+	pi.events.on(ASK_USER_BRIDGE_REQUEST_EVENT, (data: unknown) => {
+		if (!record(data) || !identifier(data.requestId)) return;
+		prune();
+		const reply = (body: Omit<QuestionnaireBridgeResponse, "requestId">) =>
+			pi.events.emit(ASK_USER_BRIDGE_RESPONSE_EVENT, { ...body, requestId: data.requestId });
+		if (data.type === "describe") return reply({ available: true });
+		if (data.type === "snapshot") {
+			return reply({ questionnaires: [...open.values()].filter((q) => !q.settled).map(snapshot) });
+		}
+		const toolCallId = typeof data.toolCallId === "string" ? data.toolCallId : "";
+		const revision = typeof data.revision === "string" ? data.revision : "";
+		const operationId = typeof data.operationId === "string" ? data.operationId : "";
+		const base = { toolCallId, revision, operationId };
+		const verdict = (value: QuestionnaireOperation["verdict"], code?: string) =>
+			reply({ operation: { ...base, verdict: value, ...(code ? { code } : {}) } });
+		if (![toolCallId, revision, operationId].every(identifier)) return verdict("invalid", "invalid_ref");
+		const key = JSON.stringify([toolCallId, revision, operationId]);
+		const previous = operations.get(key);
+		if (data.type === "operation.get")
+			return reply({ operation: previous?.operation ?? { ...base, verdict: "unknown" } });
+		if (data.type !== "submit" && data.type !== "cancel") return verdict("invalid", "invalid_type");
+		const fingerprint = createHash("sha256")
+			.update(
+				canonical({
+					type: data.type,
+					answers: data.answers,
+					globalNote: data.globalNote,
+				}),
+			)
+			.digest("hex");
+		if (previous) {
+			return previous.fingerprint === fingerprint
+				? reply({ operation: previous.operation })
+				: verdict("operation-conflict");
+		}
+		const target = open.get(toolCallId);
+		const tombstone = closed.get(JSON.stringify([toolCallId, revision]))?.value;
+		if ((!target || target.revision !== revision) && !tombstone) return verdict("stale");
+		if (!target || target.revision !== revision || target.settled) {
+			return reply({ operation: { ...base, verdict: "already-closed", state: tombstone?.state ?? target?.state } });
+		}
+		const outcome = resolveExternalAnswer(target.questions, {
+			answers: data.answers,
+			globalNote: data.globalNote,
+			cancel: data.type === "cancel",
+		});
+		const operation: QuestionnaireOperation = outcome.ok
+			? { ...base, verdict: "accepted", state: outcome.result.cancelled ? "cancelled" : "answered" }
+			: { ...base, verdict: "invalid", code: outcome.code, state: "open" };
+		// 在任何同步 state listener 可以重入之前登记回执，再完成原调用。
+		operations.set(key, { at: Date.now(), fingerprint, operation });
+		trim(operations, MAX_OPERATIONS);
+		if (outcome.ok) target.settle(outcome.result);
+		reply({ operation });
+	});
+
+	return {
+		publish(q: OpenQuestionnaire) {
+			prune();
+			const value = snapshot(q);
+			if (q.settled) {
+				closed.set(JSON.stringify([q.toolCallId, q.revision]), { at: Date.now(), value });
+				trim(closed, MAX_CLOSED);
+			}
+			pi.events.emit(ASK_USER_BRIDGE_STATE_EVENT, value);
+		},
+	};
+}
