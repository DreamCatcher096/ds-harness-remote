+		expect(h.submit(q, "op").verdict).toBe("operation-conflict");
+		expect(h.request({ type: "operation.get", ...q, operationId: "op" }).operation).toEqual(accepted);
+		expect((await done).details).toMatchObject({
+			answers: [{ answer: "B" }, { selected: ["A", "B"], answer: "custom", notes: "note" }, { answer: "free" }],
+		});
+		expect(h.dialogs).toHaveLength(2);
+		expect(h.submit(q, "late").verdict).toBe("already-closed");
