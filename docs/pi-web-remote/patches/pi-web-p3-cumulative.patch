+  const command = (type, operationId, rest = {}) => wrapper.remoteChatCommand({ ...ref, type, operationId, ...rest });
+  return { wrapper, inner, ref, command, entries, counts: () => ({ calls, aborts }), emit: value => listener(value) };
+}
+
+test('真实 entry/toolCall ID；相同文本不去重；签名／系统／details 不导出', () => {
