--- /dev/null
+++ b/app/api/remote/[id]/route.ts
@@ -0,0 +1,24 @@
+import { attachRpcSession } from "@/lib/rpc-manager";
+import { readRemoteCommand, remoteFailure, remoteJson } from "@/lib/remote-http";
+import { remoteError } from "@/lib/remote-questionnaire";
+
+export const dynamic = "force-dynamic";
+
+export async function GET(_req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  try { return remoteJson(attachRpcSession(id).getRemoteSnapshot()); }
+  catch (error) { return remoteFailure(error); }
+}
+
+export async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  try {
+    const command = await readRemoteCommand(req);
+    req.signal.throwIfAborted();
+    if (typeof command.agentInstanceId !== "string" || !command.agentInstanceId) throw remoteError("instance-required", 400);
+    // 读 body 是最后一个 await；查找、实例校验与业务效果在同一同步边界。
+    const wrapper = attachRpcSession(id, command.agentInstanceId);
+    return remoteJson(typeof command.type === "string" && command.type.startsWith("chat.")
+      ? await wrapper.remoteChatCommand(command) : wrapper.remoteCommand(command));
+  } catch (error) { return remoteFailure(error); }
+}
