+  let calls = 0;
+  let aborts = 0;
+  let complete;
+  const inner = { sessionId: 'chat-test', isStreaming: false, isCompacting: false, isBashRunning: false,
+    sessionManager: { getCwd: () => tmpdir(), getBranch: () => entries }, agent: { state: {} }, extensionRunner: {},
+    subscribe: fn => { listener = fn; return () => {}; }, dispose() {}, clearQueue: () => ({ steering: [], followUp: [] }),
+    abort: async () => { aborts++; }, prompt: (_text, options) => { calls++; options.preflightResult(); return new Promise(resolve => { complete = resolve; }); },
+  };
