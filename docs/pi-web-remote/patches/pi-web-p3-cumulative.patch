+import { remoteFiles, REMOTE_CHAT_CAPABILITY } from "@/lib/remote-chat";
+import { remoteFailure, remoteJson } from "@/lib/remote-http";
+
+export const dynamic = "force-dynamic";
+export async function GET() {
+  try {
+    const rows = new Map(remoteFiles().map(({ id, cwd, title }) => [id, { sessionId: id, cwd, title, attachable: false, agentInstanceId: undefined as string | undefined }]));
+    for (const [id, wrapper] of globalThis.__piSessions ?? []) {
+      if (!wrapper.isAlive()) continue;
+      rows.set(id, { sessionId: id, cwd: wrapper.cwd, title: rows.get(id)?.title ?? id, attachable: true, agentInstanceId: wrapper.agentInstanceId });
+    }
+    return remoteJson({ capabilities: [REMOTE_CHAT_CAPABILITY], sessions: [...rows.values()].map(row => ({ ...row, running: globalThis.__piSessions?.get(row.sessionId)?.isRunning() ?? false })) });
+  } catch (error) { return remoteFailure(error); }
+}
diff --git a/lib/remote-chat.ts b/lib/remote-chat.ts
new file mode 100644
index 0000000..b69f046
--- /dev/null
+++ b/lib/remote-chat.ts
@@ -0,0 +1,118 @@
+import { constants, closeSync, fstatSync, openSync, readSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import { getAgentDir } from "@earendil-works/pi-coding-agent";
+import { remoteError } from "./remote-questionnaire";
+
+export const REMOTE_CHAT_CAPABILITY = "pi-web.chat.v1";
+type RecordValue = Record<string, unknown>;
+const record = (v: unknown): RecordValue => v && typeof v === "object" && !Array.isArray(v) ? v as RecordValue : {};
+const DISPLAY_ROLES = new Set(["user", "assistant", "toolResult", "custom", "bashExecution"]);
+
+/** 只投影可显示字段；不传 provider 签名、系统提示或任意工具 details。 */
+export function remoteMessage(value: unknown) {
+  const m = record(value);
+  if (!DISPLAY_ROLES.has(String(m.role))) return undefined;
+  let truncated = false;
+  const text = (v: unknown) => {
+    const s = typeof v === "string" ? v : "";
+    if (s.length > 16_384) truncated = true;
+    return s.slice(0, 16_384);
+  };
+  const blocks = typeof m.content === "string" ? [{ type: "text", text: m.content }] : Array.isArray(m.content) ? m.content : [];
+  if (blocks.length > 64) truncated = true;
+  const content = blocks.slice(0, 64).map(value => {
+    const b = record(value);
+    if (b.type === "text") return { type: "text", text: text(b.text) };
+    if (b.type === "thinking") return { type: "thinking", thinking: text(b.thinking) };
+    if (b.type === "toolCall") return {
+      type: "toolCall", toolCallId: b.id ?? b.toolCallId, toolName: b.name ?? b.toolName,
+      input: text(JSON.stringify(b.arguments ?? b.input ?? {})),
+    };
+    return { type: "text", text: "[未支持的内容]" };
+  });
+  if (m.role === "bashExecution") content.push({ type: "text", text: text(m.output) });
+  return { role: String(m.role), content, ...(typeof m.toolCallId === "string" ? { toolCallId: m.toolCallId } : {}),
+    ...(typeof m.toolName === "string" ? { toolName: m.toolName } : {}), isError: m.isError === true, truncated };
+}
+
+export function remoteHistory(entries: readonly unknown[], before?: string) {
+  const messages = entries.flatMap(value => {
+    const e = record(value);
+    const source = e.type === "custom_message" ? { ...e, role: "custom" } : record(e.message);
+    return (e.type === "message" || e.type === "custom_message") && DISPLAY_ROLES.has(String(source.role)) && typeof e.id === "string" ? [{ messageId: e.id, source }] : [];
+  });
+  const end = before === undefined ? messages.length : messages.findIndex(m => m.messageId === before);
+  if (end < 0) throw remoteError("history-cursor-stale");
+  let start = end;
+  let bytes = 0;
+  const page: { messageId: string; message: NonNullable<ReturnType<typeof remoteMessage>> }[] = [];
+  while (start > 0 && page.length < 100) {
+    const entry = messages[start - 1];
+    // source 已由 DISPLAY_ROLES 验证；只投影本页，不复制整份历史正文。
+    const row = { messageId: entry.messageId, message: remoteMessage(entry.source)! };
+    const size = Buffer.byteLength(JSON.stringify(row));
+    if (bytes + size > 512 * 1024) break;
+    bytes += size;
+    page.unshift(row);
+    start--;
+  }
+  if (start === end && end > 0) throw remoteError("history-message-too-large", 413);
+  return { messages: page, hasMore: start > 0, ...(start > 0 ? { before: messages[start].messageId } : {}) };
+}
+
+// 不用 SessionManager.open（可能迁移文件），不调用 scanner（会保存索引），不创建目录。
+function readFile(path: string) {
+  const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const size = fstatSync(fd).size;
+    if (size > 64 * 1024 * 1024) throw remoteError("history-too-large", 413);
+    const buffer = Buffer.alloc(size);
+    const length = readSync(fd, buffer, 0, size, 0);
+    return buffer.subarray(0, length).toString("utf8").split("\n").flatMap(line => {
+      try { return [record(JSON.parse(line))]; } catch { return []; }
+    });
+  } finally { closeSync(fd); }
+}
+
+export function remoteFiles() {
+  const root = join(getAgentDir(), "sessions");
+  const files: { id: string; path: string; cwd: string; title: string }[] = [];
+  let directories;
+  try { directories = readdirSync(root, { withFileTypes: true }); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === "ENOENT") return files; throw error; }
+  for (const directory of directories) {
+    if (!directory.isDirectory()) continue;
+    for (const file of readdirSync(join(root, directory.name), { withFileTypes: true })) {
+      if (!file.isFile() || !file.name.endsWith(".jsonl")) continue;
+      if (files.length >= 1000) throw remoteError("catalog-too-large", 413);
+      const path = join(root, directory.name, file.name);
+      const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW);
+      try {
+        const buf = Buffer.alloc(64 * 1024);
+        const n = readSync(fd, buf, 0, buf.length, 0);
+        const first = buf.subarray(0, n).toString("utf8").split("\n")[0];
+        const h = record(JSON.parse(first));
+        if (h.type === "session" && typeof h.id === "string" && /^[a-zA-Z0-9_-]+$/.test(h.id)) {
+          files.push({ id: h.id, path, cwd: typeof h.cwd === "string" ? h.cwd : "", title: h.id });
+        }
+      } catch { /* 非法／未完整 header 不作为会话。 */ }
+      finally { closeSync(fd); }
+    }
+  }
+  return files;
+}
+
+export function coldRemoteHistory(sessionId: string, before?: string) {
+  const file = remoteFiles().find(f => f.id === sessionId);
+  if (!file) throw remoteError("session-not-found");
+  const entries = readFile(file.path).filter(e => e.type !== "session" && typeof e.id === "string");
+  const byId = new Map(entries.map(e => [e.id, e]));
+  const branch: RecordValue[] = [];
+  const seen = new Set<unknown>();
+  let entry = entries.at(-1);
+  while (entry) {
+    if (seen.has(entry.id)) throw remoteError("invalid-history");
+    seen.add(entry.id); branch.push(entry); entry = byId.get(entry.parentId);
+  }
+  return { sessionId, ...remoteHistory(branch.reverse(), before) };
+}
