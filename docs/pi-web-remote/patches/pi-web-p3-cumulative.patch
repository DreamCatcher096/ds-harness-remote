+import { coldRemoteHistory } from "@/lib/remote-chat";
+import { remoteFailure, remoteJson } from "@/lib/remote-http";
+import { remoteError } from "@/lib/remote-questionnaire";
+
+export const dynamic = "force-dynamic";
+export async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  try {
+    const url = new URL(req.url);
+    const before = url.searchParams.get("before") ?? undefined;
+    const instance = url.searchParams.get("agentInstanceId");
+    const wrapper = globalThis.__piSessions?.get(id);
+    if (instance && (!wrapper || !wrapper.isAlive() || wrapper.agentInstanceId !== instance)) throw remoteError("stale-instance");
+    return remoteJson(wrapper?.isAlive() ? wrapper.getRemoteHistory(before) : coldRemoteHistory(id, before));
+  } catch (error) { return remoteFailure(error); }
+}
