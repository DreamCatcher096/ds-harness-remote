+import { randomUUID } from "node:crypto";
+import type { EventBus } from "@earendil-works/pi-coding-agent";
+
+// 与问答插件 events.ts 的版本化 JSON 契约对应；不导出任意总线访问能力。
+const REQUEST = "rpiv:ask-user:bridge-request.v1";
+const RESPONSE = "rpiv:ask-user:bridge-response.v1";
+const STATE = "rpiv:ask-user:bridge-state.v1";
+// 不截断问题或 preview 后冒称完整问卷；超限只禁用该投影，原网页继续可答。
+const MAX_SNAPSHOT_BYTES = 1024 * 1024;
+const fitsSnapshot = (value: unknown) => Buffer.byteLength(JSON.stringify(value), "utf8") <= MAX_SNAPSHOT_BYTES;
+export interface QuestionnaireSnapshot {
+  toolCallId: string;
+  revision: string;
+  state: "open" | "answered" | "cancelled" | "aborted";
+  questions?: readonly {
+    questionIndex: number;
+    question: string;
+    header: string;
+    multiSelect: boolean;
+    options: readonly { optionIndex: number; label: string; description: string; preview?: string }[];
+  }[];
+}
+export interface QuestionnaireOperation {
+  toolCallId: string;
+  revision: string;
+  operationId: string;
+  verdict: "accepted" | "invalid" | "stale" | "already-closed" | "operation-conflict" | "unknown";
+  state?: QuestionnaireSnapshot["state"];
+  code?: string;
+}
+interface BridgeResponse {
+  requestId: string;
+  available?: boolean;
+  questionnaires?: QuestionnaireSnapshot[];
+  operation?: QuestionnaireOperation;
+}
+
+export function remoteError(code: string, status = 409): Error {
+  return Object.assign(new Error(code), { code, status });
+}
+
+/** 只操作原 resource loader 的总线。SDK 1.5.2 EventBus 同步调用同步 listener。 */
+export class RemoteQuestionnaireBridge {
+  constructor(private readonly bus: EventBus) {}
+
+  private request(payload: Record<string, unknown>): BridgeResponse | undefined {
+    const requestId = randomUUID();
+    let result: BridgeResponse | undefined;
+    let replies = 0;
+    const off = this.bus.on(RESPONSE, (data) => {
+      const response = data as BridgeResponse | null;
+      if (response?.requestId === requestId) {
+        result = response;
+        replies += 1;
+      }
+    });
+    try {
+      this.bus.emit(REQUEST, { ...payload, requestId });
+      return replies === 1 ? result : undefined;
+    } finally {
+      off();
+    }
+  }
+
+  snapshot(): QuestionnaireSnapshot[] | undefined {
+    if (this.request({ type: "describe" })?.available !== true) return undefined;
+    const questionnaires = this.request({ type: "snapshot" })?.questionnaires;
+    if (questionnaires && !fitsSnapshot(questionnaires)) throw remoteError("questionnaire-too-large", 413);
+    return questionnaires;
+  }
+
+  operation(command: Record<string, unknown>): QuestionnaireOperation {
+    const type = command.type === "questionnaire.submit" ? "submit"
+      : command.type === "questionnaire.cancel" ? "cancel" : "operation.get";
+    const response = this.request({
+      type, toolCallId: command.toolCallId, revision: command.revision,
+      operationId: command.operationId, answers: command.answers, globalNote: command.globalNote,
+    });
+    if (!response?.operation) throw remoteError("questionnaire-unavailable");
+    return response.operation;
+  }
+
+  onState(listener: (event: { type: string; [key: string]: unknown }) => void): () => void {
+    return this.bus.on(STATE, (value) => {
+      const questionnaire = value as QuestionnaireSnapshot;
+      listener(fitsSnapshot(questionnaire) ? { type: "questionnaire_state", questionnaire } : {
+        type: "questionnaire_unavailable", code: "questionnaire-too-large",
+        toolCallId: questionnaire.toolCallId, revision: questionnaire.revision,
+      });
+    });
+  }
+}
