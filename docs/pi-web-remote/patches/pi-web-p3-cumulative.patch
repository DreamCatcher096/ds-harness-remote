diff --git a/lib/remote-bridge.integration.mjs b/lib/remote-bridge.integration.mjs
new file mode 100644
index 0000000..9bdc086
--- /dev/null
+++ b/lib/remote-bridge.integration.mjs
@@ -0,0 +1,141 @@
+// 显式跨源码契约夹具：不构造 AgentSession、不运行服务、不加载用户配置。
+import assert from "node:assert/strict";
+import test from "node:test";
+import { join, resolve } from "node:path";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { createEventBus, DefaultResourceLoader, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { createJiti } from "jiti";
+
+assert.ok(process.env.PI_WEB_QUESTIONNAIRE_SOURCE, "显式设置固定版本问答插件源码目录，不能跳过此集成测试");
+const source = resolve(process.env.PI_WEB_QUESTIONNAIRE_SOURCE);
+const jiti = createJiti(import.meta.url, { tsconfigPaths: true });
+const { registerAskUserQuestionTool } = await jiti.import(`${source}/ask-user-question.ts`);
+const { AgentSessionWrapper } = await jiti.import("./rpc-manager.ts");
+const { RemoteQuestionnaireBridge } = await jiti.import("./remote-questionnaire.ts");
+const routes = await jiti.import("../app/api/remote/[id]/route.ts");
+const eventRoutes = await jiti.import("../app/api/remote/[id]/events/route.ts");
+const question = (header, multiSelect = false) => ({ question: `${header}?`, header, multiSelect,
+  options: [{ label: "A", description: "a", preview: "**preview**" }, { label: "B", description: "b" }] });
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+test("SDK ResourceLoader 注入同一总线；invalidate/reload 解除旧插件监听，无重复裁决者", async (t) => {
+  const directory = mkdtempSync(join(tmpdir(), "bridge-loader-"));
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  const bus = createEventBus();
+  const bridge = new RemoteQuestionnaireBridge(bus);
+  const loader = new DefaultResourceLoader({
+    cwd: directory, agentDir: join(directory, "agent"), eventBus: bus,
+    settingsManager: SettingsManager.inMemory(),
+    noExtensions: true, noSkills: true, noPromptTemplates: true, noThemes: true, noContextFiles: true,
+    extensionFactories: [registerAskUserQuestionTool],
+  });
+  assert.equal(bridge.snapshot(), undefined);
+  await loader.reload();
+  assert.deepEqual(bridge.snapshot(), []);
+  loader.getExtensions().runtime.invalidate();
+  assert.equal(bridge.snapshot(), undefined);
+  await loader.reload();
+  assert.deepEqual(bridge.snapshot(), []);
+  loader.getExtensions().runtime.invalidate();
+  bus.clear();
+});
+
+function fixture(t, sessionId = "integration") {
+  const bus = createEventBus(); // Pi Web 安装的真实 SDK 1.5.2 总线。
+  let tool;
+  registerAskUserQuestionTool({ events: bus, registerTool: (value) => { tool = value; } });
+  const inner = { sessionId, isStreaming: false, isCompacting: false, isBashRunning: false,
+    sessionManager: { getCwd: () => "/tmp" }, agent: { state: {} }, extensionRunner: {}, dispose() {} };
+  const wrapper = new AgentSessionWrapper(inner, { questionnaireBridge: new RemoteQuestionnaireBridge(bus) });
+  globalThis.__piSessions ??= new Map();
+  globalThis.__piSessions.set(sessionId, wrapper);
+  t.after(() => { wrapper.destroy(); globalThis.__piSessions.delete(sessionId); });
+  const ui = wrapper.createExtensionUiContext();
+  const seen = [];
+  wrapper.onEvent((event) => seen.push(event));
+  const context = { params: Promise.resolve({ id: sessionId }) };
+  const url = `http://localhost/api/remote/${sessionId}`;
+  const snapshot = async () => (await routes.GET(new Request(url), context)).json();
+  const command = async (body) => {
+    const response = await routes.POST(new Request(url, { method: "POST", body: JSON.stringify({
+      ...body, sessionId, agentInstanceId: wrapper.agentInstanceId,
+    }) }), context);
+    assert.equal(response.status, 200);
+    return response.json();
+  };
+  return { wrapper, seen, snapshot, command, context, url, run: (id, questions) => tool.execute(id, { questions }, undefined, undefined, { hasUI: true, mode: "rpc", ui }) };
+}
+
+test("原 wrapper UI + 原插件 + 真实 EventBus：网页部分作答／手机整份提交／重连／查询", async (t) => {
+  const h = fixture(t);
+  const done = h.run("original-call", [question("One"), question("Many", true), question("Text")]);
+  const s = await h.snapshot();
+  assert.ok(s.capabilities.includes("pi-web.questionnaire.v1"));
+  const q = s.questionnaires[0];
+  assert.equal(q.questions[0].options[0].preview, "**preview**");
+  const first = h.seen.find((e) => e.type === "extension_ui_request");
+  assert.equal((await h.command({ type: "ui.respond", id: first.id, value: first.options[0] })).verdict, "accepted");
+  await tick();
+  const second = h.seen.findLast((e) => e.type === "extension_ui_request");
+  assert.equal(second.method, "input");
+  const answers = [{ questionIndex: 0, optionIndexes: [1] }, { questionIndex: 1, optionIndexes: [0, 1], text: "extra", notes: " note " }, { questionIndex: 2, text: "free" }];
+  const submit = { type: "questionnaire.submit", toolCallId: q.toolCallId, revision: q.revision, operationId: "stable", answers, globalNote: "global" };
+  const accepted = await h.command(submit);
+  assert.equal(accepted.verdict, "accepted");
+  assert.deepEqual(await h.command(submit), accepted);
+  assert.equal((await h.command({ ...submit, answers: [] })).verdict, "operation-conflict");
+  assert.deepEqual(await h.command({ type: "operation.get", ...q, operationId: "stable" }), accepted);
+  const result = await done;
+  assert.equal(result.details.cancelled, false);
+  assert.deepEqual(result.details.answers.map((a) => a.answer), ["B", "extra", "free"]);
+  assert.equal(result.details.answers[1].notes, "note");
+  assert.equal(h.wrapper.pendingUiRequests.size, 0);
+  assert.equal(h.seen.filter((e) => e.type === "extension_ui_request").length, 2);
+  assert.equal((await h.command({ ...submit, operationId: "late" })).verdict, "already-closed");
+  // 断线后只重新订阅并拉取权威快照，不重放任何业务写入。
+  const response = await eventRoutes.GET(new Request(`${h.url}/events?agentInstanceId=${s.agentInstanceId}`), h.context);
+  const reader = response.body.getReader();
+  let connected;
+  while (!connected) {
+    const { value } = await reader.read();
+    const text = new TextDecoder().decode(value);
+    if (text.startsWith("data: ")) connected = JSON.parse(text.slice(6));
+  }
+  assert.equal(connected.type, "connected");
+  assert.deepEqual(connected.remoteSnapshot.questionnaires, []);
+  assert.deepEqual(connected.pendingExtensionUiIds, []);
+  await reader.cancel();
+});
+
+test("完整问卷投影超 1 MiB 明确拒绝，不截断、不关闭原网页问题", async (t) => {
+  const h = fixture(t);
+  const large = question("Large");
+  large.options[0].preview = "x".repeat(1024 * 1024);
+  const done = h.run("large-call", [large]);
+  const response = await routes.GET(new Request(h.url), h.context);
+  assert.equal(response.status, 413);
+  assert.equal((await response.json()).error, "questionnaire-too-large");
+  assert.equal(h.seen.find((event) => event.type === "questionnaire_unavailable").toolCallId, "large-call");
+  const dialog = h.seen.findLast((event) => event.type === "extension_ui_request");
+  await h.command({ type: "ui.respond", id: dialog.id, value: dialog.options[1] });
+  assert.equal((await done).details.answers[0].answer, "B");
+});
+
+test("总线作用域隔离；同 toolCallId 不会串到其他原 wrapper", async (t) => {
+  const a = fixture(t, "a");
+  const b = fixture(t, "b");
