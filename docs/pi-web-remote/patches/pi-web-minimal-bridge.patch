+++ b/lib/remote-bridge.test.mjs
@@ -0,0 +1,127 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createEventBus } from "@earendil-works/pi-coding-agent";
+import { createJiti } from "jiti";
+
+const jiti = createJiti(import.meta.url, { tsconfigPaths: true });
+const { AgentSessionWrapper, attachRpcSession } = await jiti.import("./rpc-manager.ts");
+const { RemoteQuestionnaireBridge } = await jiti.import("./remote-questionnaire.ts");
+const routes = await jiti.import("../app/api/remote/[id]/route.ts");
+const events = await jiti.import("../app/api/remote/[id]/events/route.ts");
+const context = { params: Promise.resolve({ id: "same-session" }) };
+const base = "http://localhost/api/remote/same-session";
+
+function fixture(t) {
+  const before = globalThis.__piSessions;
+  const inner = {
+    sessionId: "same-session", isStreaming: false, isCompacting: false, isBashRunning: false,
+    sessionManager: { getCwd: () => "/tmp" }, agent: { state: {} }, extensionRunner: {},
+    dispose() { this.disposed = true; },
+  };
+  const bus = createEventBus();
+  const wrapper = new AgentSessionWrapper(inner, { questionnaireBridge: new RemoteQuestionnaireBridge(bus) });
+  globalThis.__piSessions = new Map([[inner.sessionId, wrapper]]);
+  t.after(() => { wrapper.destroy(); globalThis.__piSessions = before; });
+  const command = (body) => ({ sessionId: inner.sessionId, agentInstanceId: wrapper.agentInstanceId, ...body });
+  const post = (body) => routes.POST(new Request(base, { method: "POST", body: JSON.stringify(command(body)) }), context);
+  return { inner, wrapper, bus, command, post };
+}
+
+async function nextData(reader) {
+  for (;;) {
+    const chunk = await reader.read();
+    if (chunk.done) return null;
+    const text = new TextDecoder().decode(chunk.value);
+    if (text.startsWith("data: ")) return JSON.parse(text.slice(6));
+  }
+}
+
+test("缺失实例 GET/SSE/POST 不创建 registry、会话或 start lock", async () => {
+  const before = globalThis.__piSessions;
+  globalThis.__piSessions = undefined;
+  try {
+    assert.throws(() => attachRpcSession("missing"), { code: "not-attachable" });
+    const locks = globalThis.__piStartLocks;
+    assert.equal((await routes.GET(new Request(base), context)).status, 409);
+    assert.equal((await events.GET(new Request(`${base}/events?agentInstanceId=old`), context)).status, 409);
+    assert.equal((await routes.POST(new Request(base, { method: "POST", body: JSON.stringify({ agentInstanceId: "old" }) }), context)).status, 409);
+    assert.equal(globalThis.__piSessions, undefined);
+    assert.equal(globalThis.__piStartLocks, locks);
+  } finally { globalThis.__piSessions = before; }
