+test("能力不伪造；两个订阅附着同一 wrapper，有独立 epoch，取消不 dispose 原实例", async (t) => {
+  const { wrapper, inner } = fixture(t);
+  const snapshot = await (await routes.GET(new Request(base), context)).json();
+  assert.equal(snapshot.agentInstanceId, wrapper.agentInstanceId);
+  assert.deepEqual(snapshot.capabilities, ["pi-web.attach.v1"]);
+  const readers = [];
+  for (let i = 0; i < 2; i++) {
+    const response = await events.GET(new Request(`${base}/events?agentInstanceId=${wrapper.agentInstanceId}`), context);
+    assert.equal(response.status, 200);
+    readers.push(response.body.getReader());
+  }
+  const connected = await Promise.all(readers.map(nextData));
+  assert.notEqual(connected[0].epoch, connected[1].epoch);
+  for (const event of connected) {
+    assert.equal(event.agentInstanceId, wrapper.agentInstanceId);
+    assert.equal(event.remoteSnapshot.agentInstanceId, wrapper.agentInstanceId);
+    assert.equal(event.seq, 1);
+  }
+  wrapper.emit({ type: "agent_start" });
+  for (const reader of readers) assert.equal((await nextData(reader)).seq, 2);
+  await Promise.all(readers.map((reader) => reader.cancel()));
+  assert.equal(inner.disposed, undefined);
+  assert.equal(wrapper.listeners.size, 0);
+});
+
+test("同 session 被替换／body 等待后关闭，旧请求在效果前被拒绝", async (t) => {
+  const { wrapper, inner, post } = fixture(t);
+  assert.equal((await post({ type: "ui.respond", id: "unknown", agentInstanceId: "old" })).status, 409);
+  let release;
+  const body = new ReadableStream({ start(controller) { release = () => { controller.enqueue(new TextEncoder().encode(JSON.stringify({ sessionId: inner.sessionId, agentInstanceId: wrapper.agentInstanceId, type: "ui.respond", id: "unknown" }))); controller.close(); }; } });
+  const request = new Request(base, { method: "POST", body, duplex: "half" });
+  const pending = routes.POST(request, context);
+  const replacement = new AgentSessionWrapper(inner);
+  globalThis.__piSessions.set(inner.sessionId, replacement);
+  t.after(() => replacement.destroy());
+  release();
+  assert.equal((await pending).status, 409);
+  assert.throws(() => wrapper.remoteCommand({ sessionId: inner.sessionId, agentInstanceId: wrapper.agentInstanceId, type: "ui.respond" }), { code: "not-attachable" });
+});
+
+test("普通 UI 回执按真实 ID；错误值不消费、取消不采纳夹带 value、未知 ID 不假成功", async (t) => {
+  const { wrapper, post } = fixture(t);
+  const seen = [];
+  wrapper.onEvent((event) => seen.push(event));
+  const pending = wrapper.createExtensionUiContext().select("Pick", ["A", "B"]);
+  const id = seen.at(-1).id;
+  assert.equal((await post({ type: "ui.respond", id, value: "wrong" })).status, 400);
+  assert.deepEqual(await (await post({ type: "ui.respond", id: "missing", value: "A" })).json(), { id: "missing", verdict: "already-closed" });
+  assert.equal((await (await post({ type: "ui.respond", id, cancelled: true, value: "A" })).json()).verdict, "accepted");
+  assert.equal(await pending, undefined);
+  assert.equal((await (await post({ type: "ui.respond", id, value: "A" })).json()).verdict, "already-closed");
+  assert.equal((await post({ type: "prompt", message: "must not execute" })).status, 400);
+});
+
+test("lookup 后实例关闭的 SSE 给明确终止帧，不隐式创建替代实例", async (t) => {
+  const { wrapper } = fixture(t);
+  const response = await events.GET(new Request(`${base}/events?agentInstanceId=${wrapper.agentInstanceId}`), context);
+  const reader = response.body.getReader();
+  const connected = await nextData(reader);
+  assert.equal(connected.type, "connected");
+  wrapper.destroy();
+  const ended = await nextData(reader);
+  assert.equal(ended.type, "attachment_ended");
+  assert.equal(ended.code, "not-attachable");
+  assert.equal(ended.agentInstanceId, wrapper.agentInstanceId);
+  assert.equal(await nextData(reader), null);
+  assert.equal((await routes.GET(new Request(base), context)).status, 409);
+});
+
+test("请求体实际字节限额、非法 JSON 与缺少实例在业务前拒绝", async (t) => {
+  const { post } = fixture(t);
+  assert.equal((await post({ type: "ui.respond", value: "x".repeat(1024 * 1024) })).status, 413);
+  assert.equal((await routes.POST(new Request(base, { method: "POST", body: "{" }), context)).status, 400);
+  assert.equal((await routes.POST(new Request(base, { method: "POST", body: "{}" }), context)).status, 400);
+});
diff --git a/lib/remote-http.ts b/lib/remote-http.ts
new file mode 100644
index 0000000..be40502
--- /dev/null
+++ b/lib/remote-http.ts
@@ -0,0 +1,47 @@
+import { remoteError } from "./remote-questionnaire";
+
+const MAX_BODY_BYTES = 1024 * 1024;
+
+/** 限额在解析之前生效，不信任 Content-Length；不记录原始请求或错误正文。 */
+export async function readRemoteCommand(req: Request): Promise<Record<string, unknown>> {
+  if (Number(req.headers.get("content-length")) > MAX_BODY_BYTES) throw remoteError("body-too-large", 413);
+  if (!req.body) throw remoteError("invalid-command", 400);
+  const reader = req.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let bytes = 0;
+  try {
+    for (;;) {
+      req.signal.throwIfAborted();
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > MAX_BODY_BYTES) {
+        await reader.cancel();
+        throw remoteError("body-too-large", 413);
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const data = new Uint8Array(bytes);
+  let offset = 0;
+  for (const chunk of chunks) { data.set(chunk, offset); offset += chunk.byteLength; }
+  let parsed: unknown;
+  try { parsed = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(data)); }
+  catch { throw remoteError("invalid-command", 400); }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw remoteError("invalid-command", 400);
+  return parsed as Record<string, unknown>;
+}
+
+export function remoteJson(data: unknown): Response {
+  return Response.json(data, { headers: { "Cache-Control": "no-store" } });
+}
+
+export function remoteFailure(error: unknown): Response {
+  const failure = error as { code?: unknown; status?: unknown } | null;
+  const status = typeof failure?.status === "number" && [400, 409, 413].includes(failure.status) ? failure.status : 500;
+  return Response.json({ error: status === 500 ? "bridge-error" : failure?.code }, {
+    status, headers: { "Cache-Control": "no-store" },
+  });
+}
