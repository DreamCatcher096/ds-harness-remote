@@ -0,0 +1,22 @@
+import { attachRpcSession } from "@/lib/rpc-manager";
+import { readRemoteCommand, remoteFailure, remoteJson } from "@/lib/remote-http";
+import { remoteError } from "@/lib/remote-questionnaire";
+
+export const dynamic = "force-dynamic";
+
+export async function GET(_req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  try { return remoteJson(attachRpcSession(id).getRemoteSnapshot()); }
+  catch (error) { return remoteFailure(error); }
+}
+
+export async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  try {
+    const command = await readRemoteCommand(req);
+    req.signal.throwIfAborted();
+    if (typeof command.agentInstanceId !== "string" || !command.agentInstanceId) throw remoteError("instance-required", 400);
+    // 读 body 是最后一个 await；查找、实例校验与业务效果在同一同步边界。
+    return remoteJson(attachRpcSession(id, command.agentInstanceId).remoteCommand(command));
+  } catch (error) { return remoteFailure(error); }
+}
diff --git a/docs/agents/sessions.md b/docs/agents/sessions.md
index d367719..eb4cc73 100644
--- a/docs/agents/sessions.md
+++ b/docs/agents/sessions.md
@@ -321,3 +321,13 @@ Files: `lib/markdown.ts` (`markdownClobberPrefix`, `rehypeMatchClobberedIds`, `j
 - Code fences (`CodeBlock`, `components/MermaidBlock.tsx`): Prism tokenizes in the render, about 5-10 ms per 1,000 characters of TypeScript on a desktop. Within one task the first 2,000 characters of fences are highlighted at once (`takeHighlightBudget()`); the others render through the same `SyntaxHighlighter` as `text` (same lines, numbers and box, no tokens) and take their language one per idle slice, newest first (`waitForHighlight()`; Safari has no `requestIdleCallback` and waits 50 ms). Opening a session with 86 fences at 4x CPU throttling, the commit that shows the messages went from 1.1 s to 0.66 s; the end of a streamed reply gets the same budget. `codeTagProps` sets no class, so tell a highlighted fence by its `span.token` elements, not by a `language-*` class. Fences wrap long lines, as pi's TUI does (no toggle; #1360): `renderCodeLines()` makes each line a flex row of its number and its text (`.markdown-code-line`, `overflow-wrap: anywhere` for URLs and paths), so a wrapped line goes on under its text, the text keeping the row's classes (the later lines of a block comment take their color from them), and an extension dialog measures its fences unwrapped (`.extension-dialog-measuring`) so it still widens to show them whole where the screen allows (#947). The visible number is generated from the gutter's `data-line-number`, not a text node: WebKit (Safari, every iOS browser) otherwise paints the numbers a selection crosses despite `user-select: none` and puts them in `getSelection().toString()`; Chromium did neither. The file viewer's Source view still has text-node numbers.
 - While streaming, a fence's plain `<pre>` holds its text in 64-line pieces (`StreamingCodeChunks`), the same idea as long thinking (#1248): only the last piece changes per chunk, so React rewrites one short text node and the browser lays out one piece; finished pieces are `content-visibility: auto`, skipped while off screen. The newline between pieces is the block boundary, not text: kept in a piece, a copied selection got a blank line at every boundary.
 - Prism languages load on demand (`lib/prism-languages.ts`, `hooks/usePrismLanguages.ts`). `CodeBlock` and `FileViewer` render with `react-syntax-highlighter/dist/esm/prism-light` (refractor's core), never the package index: its `Prism` imports `refractor/all`, which registers about 300 languages when evaluated, ~650 ms of the first `AppShell` render at 4x CPU throttling on every page load, code on screen or not. The first highlighter to mount imports `refractor/all` as a chunk of its own; it registers into the same core instance, so every language and alias works as before. Until then fences render as `text` and files as `plaintext` (same lines, numbers and box). A page with no code never loads it. Client code imports only types from `react-syntax-highlighter` itself.
+
+## 最小桥接分支：只附着与完整问卷
+
+`/api/remote/[id]` GET 同步读取 registry 中 alive 的原 wrapper；POST 仅允许 questionnaire.submit/cancel、operation.get 和普通 ui.respond。`/events` 必须带 agentInstanceId；旧 agent 路由的创建/恢复行为不变，不能给新 Host 混用。新入口受原 proxy 的认证与来源规则保护，instanceId 不是密码，不是公网准入方案。
+
+wrapper 的实例 ID 在生命周期内稳定；POST 读完有界 body 后才查 registry，remoteCommand 在同一同步边界校验 session/instance、执行原控制器。SSE 先注册 listener 再读问卷 snapshot；新流帧带 instance、epoch/seq，重连只重建投影，不自动提交。既有增量合并/背压仍有效，不承诺持久游标或历史无缺口；关闭给 attachment_ended，不转去 startRpcSession。
+
+每个原 ResourceLoader 显式注入独立 SDK EventBus；`remote-questionnaire.ts` 只转发 rpiv 的版本化桥接协议，不导出通用 emit。只有新版插件同步握手/快照成功才声明 pi-web.questionnaire.v1；旧插件仍可使用网页 RPC walker。插件 reload 时 SDK 会解除旧扩展总线监听，新的 revision 阻止旧问卷复用。wrapper 销毁只释放自身桥接监听，不由网络断线触发 Agent abort。
+
+测试：remote-bridge.test.mjs 为无模型 wrapper/route 夹具；remote-bridge.integration.mjs 必须显式设置 PI_WEB_QUESTIONNAIRE_SOURCE，连接固定源码插件与真实 SDK EventBus、原 wrapper UI，但不创建 AgentSession 或启动服务。它不是生产/Android 验收。跨仓库接口、执行记录见主开发仓库 docs/pi-web-remote/MINIMAL-BRIDGE-ADR.md。
