@@ -0,0 +1,23 @@
+import { createAgentEventStream } from "@/lib/agent-event-stream";
+import { attachRpcSession } from "@/lib/rpc-manager";
+import { remoteFailure } from "@/lib/remote-http";
+import { remoteError } from "@/lib/remote-questionnaire";
+
+export const dynamic = "force-dynamic";
+
+export async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  if (req.signal.aborted) return new Response(null, { status: 204 });
+  try {
+    const instance = new URL(req.url).searchParams.get("agentInstanceId");
+    if (!instance) throw remoteError("instance-required", 400);
+    const session = attachRpcSession(id, instance);
+    const stream = createAgentEventStream(req, id, Promise.resolve(session), {
+      remote: { agentInstanceId: instance, snapshot: () => session.getRemoteSnapshot() },
+    });
+    return new Response(stream, { headers: {
+      "Content-Type": "text/event-stream", "Cache-Control": "no-cache, no-transform",
+      Connection: "keep-alive", "X-Accel-Buffering": "no",
+    } });
+  } catch (error) { return remoteFailure(error); }
+}
